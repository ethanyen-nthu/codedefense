# Copy to .env.local. Never commit real secrets.
# All fields below are required for live AI; blank values keep the demo usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000

# Shared limits; UTC day boundaries. Actual provider attempts, including retries, count.
DAILY_GLOBAL_REQUEST_CAP=300
DAILY_SESSION_REQUEST_CAP=25
DAILY_IP_REQUEST_CAP=60
MAX_CONCURRENT_AI_REQUESTS=3
MAX_CODE_CHARS=30000
MAX_INPUT_TOKENS=24000
MAX_OUTPUT_TOKENS=10000

# Optional current model prices (USD / million tokens). Leave blank to omit estimates.
# Update BOTH when changing OPENAI_MODEL. These are estimates, not billing controls.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
